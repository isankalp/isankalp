# Copy to .env.local (git-ignored) for local dev, and set the same keys in your host's
# environment variables (e.g. Vercel → Project Settings → Environment Variables) for deploys.
# Every key here is optional — the app runs fully local-first with none of them set.

# Google Calendar sync (Settings → Integrations). Create an OAuth client (Web application) in
# Google Cloud Console, add this app's origin as an authorized JavaScript origin and
# "<origin>/settings" as an authorized redirect URI.
VITE_GOOGLE_CLIENT_ID=

# Real accounts (Sign Up / Log In / password reset / sessions). Create a free project at
# https://supabase.com, then Project Settings → API for these two values. For Google sign-in,
# also enable the Google provider under Authentication → Providers and add the same OAuth
# client's ID/secret there.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
