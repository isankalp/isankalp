# Secrets for the spotify-* Edge Functions. Set these with the Supabase CLI, never in a .env file
# committed to the repo:
#
#   supabase secrets set SPOTIFY_CLIENT_ID=... SPOTIFY_CLIENT_SECRET=... SPOTIFY_STATE_SECRET=... APP_URL=...
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically to every Edge Function by
# Supabase itself — do not set those two here.

# From your Spotify app's dashboard (https://developer.spotify.com/dashboard) — Client ID is
# public, Client Secret is not. NEVER paste the secret into chat, a commit, or anywhere other than
# `supabase secrets set` directly in your own terminal. If it's ever been shared anywhere else,
# rotate it first ("Rotate client secret" in the app's Settings) before setting it here.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Any long random string of your own choosing (e.g. `openssl rand -hex 32`) — signs the OAuth
# `state` param so spotify-oauth-callback can trust it. Not a Spotify value; you invent this one.
SPOTIFY_STATE_SECRET=

# Your deployed app's origin, no trailing slash (e.g. https://your-app.vercel.app, or
# http://localhost:5173 for local dev) — where spotify-oauth-callback redirects the browser back
# to after connecting.
APP_URL=
